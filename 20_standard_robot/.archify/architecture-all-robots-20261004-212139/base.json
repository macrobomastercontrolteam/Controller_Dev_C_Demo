  "cards": [
    {
      "dot": "cyan",
      "title": "Shared runtime and feedback",
      "items": [
        "STM32F407 Type C firmware; FreeRTOS tasks created in Src/freertos.c:164–213.",
        "Motor CAN interrupts update measurements read by both control loops.",
        "Chassis also reads INS attitude and gimbal encoders (chassis_task.c:177–180).",
        "Launcher heat limits use referee state; see shoot.c and CAN_receive.c:1680–1683."
      ]
    },
    {
      "dot": "amber",
      "title": "Configuration conditions",
      "items": [
        "Each profile is a separate compile-time build, not nine concurrent robots.",
        "Local referee UART unpacking requires ENABLE_REFREE_UART_PORT and a remote type other than VT13.",
        "Power ON profiles bypass the active power loop with Shift and buffer > 30 (chassis_task.c:1195–1212).",
        "CV task requires CV_INTERFACE; both Sentry types require it for competition."
      ]
    },
